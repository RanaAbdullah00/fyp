{
  "name": "transpak",
  "private": true,
  "description": "TransPak monorepo — run npm scripts from repo root or from transpak-backend / transpak-frontend",
  "scripts": {
    "sync:deploy-repos": "node scripts/sync-deploy-repos.mjs",
    "wait:production": "node scripts/wait-production-sync.mjs",
    "wait:frontend": "node scripts/wait-frontend-sync.mjs",
    "verify:deploy-chain": "node scripts/verify-deploy-chain.mjs",
    "verify:production": "node scripts/verify-deploy-chain.mjs --strict && npm run verify:production --prefix transpak-backend -- --strict",
    "audit:production-db": "npm run audit:production-db --prefix transpak-backend",
    "predeploy:check": "npm run predeploy:check --prefix transpak-backend",
    "db:migrate": "npm run db:migrate --prefix transpak-backend",
    "backend:dev": "npm run dev --prefix transpak-backend",
    "backend:start": "npm run start --prefix transpak-backend",
    "frontend:dev": "npm run dev --prefix transpak-frontend",
    "frontend:build": "npm run build --prefix transpak-frontend",
    "validate:behavioral": "node scripts/behavioral-validation.mjs"
  }
}

PORT=5000
NODE_ENV=development

# PostgreSQL (preferred: DATABASE_URL). Example:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/transpak
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=transpak
PGUSER=postgres
PGPASSWORD=postgres

# Cloudinary (media storage)
# Prefer CLOUDINARY_URL. Alternatively set CLOUDINARY_CLOUD_NAME/CLOUDINARY_API_KEY/CLOUDINARY_API_SECRET.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# For local dev with Vite (adjust as needed)
CORS_ORIGIN=http://localhost:5173

